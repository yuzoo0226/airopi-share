# =============================================================================
#  openpi pi0 / pi0.5 policy server (websocket) — arm64 / amd64
#
#  Inference-only image: it deliberately skips the training dependencies
#  (lerobot, torch, torchcodec, ffmpeg 7, wandb) because the released HSR
#  checkpoints are JAX/orbax and `server/serve_hsr_policy_ws.py` never imports
#  the LeRobot data pipeline. That keeps the image buildable on aarch64 in a
#  couple of minutes instead of compiling PyAV/FFmpeg from source.
#
#  JAX pulls the CUDA runtime through its own nvidia-* wheels, so no CUDA base
#  image is required — only the NVIDIA container runtime on the host.
#  Set JAX_PLATFORMS=cpu to force CPU inference.
# =============================================================================
FROM python:3.11-slim-bookworm

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates libgl1 libglib2.0-0 procps \
    && rm -rf /var/lib/apt/lists/*


# --- python dependencies ----------------------------------------------------
# NOTE on the JAX version: pyproject.toml pins jax[cuda12]==0.5.3, but the XLA
# shipped with jaxlib 0.5.3 does not know sm_121 (NVIDIA GB10 / DGX Spark) and
# dies with "Unsupported rounding mode for conversion" as soon as a float16 or
# bfloat16 kernel is compiled — which pi0.5 inference does immediately, since
# the params are restored as bfloat16. jaxlib 0.6.2 is the smallest bump that
# compiles f32/f16/bf16 correctly on sm_121 while keeping numpy<2 (jax 0.7.2
# already requires numpy>=2.0) and still resolving against flax 0.10.2 /
# orbax-checkpoint 0.11.14. Override with --build-arg JAX_VERSION=... ; 0.5.3 is
# fine on x86 Ampere/Hopper.
# The ml-dtypes / tensorstore overrides from [tool.uv] are dropped on purpose:
# they exist to satisfy the old jax pin and conflict with 0.6.x.
# orbax-checkpoint 0.11.13 (the pyproject pin) still references
# jax.experimental.layout.DeviceLocalLayout, which jax 0.6 renamed, so it fails
# to import here; 0.11.14 is the first release that works with jax 0.6.2.
ARG JAX_VARIANT=cuda12
ARG JAX_VERSION=0.6.2
ARG ORBAX_VERSION=0.11.14
RUN pip install --upgrade pip setuptools wheel

# Transitive dependencies silently move jax and numpy in later layers (chex, for
# example, pulls jax 0.7.x, which orbax 0.11.14 then fails to import against). A
# global pip constraint file pins the whole image to one consistent set.
RUN printf 'numpy<2\njax==%s\njaxlib==%s\norbax-checkpoint==%s\nflax==0.10.2\n' \
        "${JAX_VERSION}" "${JAX_VERSION}" "${ORBAX_VERSION}" > /etc/pip-constraints.txt \
    && cat /etc/pip-constraints.txt
ENV PIP_CONSTRAINT=/etc/pip-constraints.txt

RUN pip install \
        "jax[${JAX_VARIANT}]==${JAX_VERSION}" \
        "flax==0.10.2" \
        "orbax-checkpoint==${ORBAX_VERSION}" \
        "numpy>=1.22.4,<2.0.0"

RUN pip install \
        "augmax>=0.3.4" \
        "beartype==0.19.0" \
        "chex>=0.1.86" \
        "dm-tree>=0.1.8" \
        "einops>=0.8.0" \
        "equinox>=0.11.8" \
        "etils[epath]>=1.9.0" \
        "filelock>=3.16.1" \
        "flatbuffers>=24.3.25" \
        "fsspec[gcs]>=2024.6.0" \
        "imageio>=2.36.1" \
        "jaxtyping==0.2.36" \
        "ml_collections==1.0.0" \
        "msgpack>=1.0.5" \
        "numpydantic>=1.6.6" \
        "opencv-python-headless>=4.10.0.84" \
        "pillow>=11.0.0" \
        "polars>=1.30.0" \
        "pyyaml>=6.0.2" \
        "rich>=14.0.0" \
        "sentencepiece>=0.2.0" \
        "tqdm-loggable>=0.2" \
        "transformers==4.53.2" \
        "treescope>=0.1.7" \
        "typing-extensions>=4.12.2" \
        "tyro>=0.9.5" \
        "websockets>=11.0"

# openpi/models/model.py imports torch unconditionally (it is only used by the
# `load_pytorch` path), so the JAX-only server still needs it importable. The
# aarch64 wheel on PyPI is the ~100 MB CPU build and pulls no CUDA runtime.
RUN pip install "torch==2.7.1" "pytest>=8.3.4"

# --- user matching the host so mounted caches stay writable -----------------
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd -g ${USER_GID} openpi 2>/dev/null || true \
    && useradd -m -u ${USER_UID} -g ${USER_GID} -s /bin/bash openpi 2>/dev/null || true \
    && mkdir -p /home/openpi && chown ${USER_UID}:${USER_GID} /home/openpi

# The repository itself is bind mounted at /home/openpi at runtime; adding both
# source roots to PYTHONPATH makes `openpi` and `openpi_client` importable
# without an editable install.
ENV PYTHONPATH=/home/openpi/src:/home/openpi/packages/openpi-client/src \
    HOME=/home/openpi \
    XLA_PYTHON_CLIENT_PREALLOCATE=false

COPY docker/ros2/entrypoint-server.sh /usr/local/bin/entrypoint-server.sh
RUN chmod +x /usr/local/bin/entrypoint-server.sh

USER openpi
WORKDIR /home/openpi
ENTRYPOINT ["/usr/local/bin/entrypoint-server.sh"]
CMD ["serve"]
