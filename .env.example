# Training / experiment settings.
# Copy to `.env` and edit.
# Personal settings (paths, credentials) go in `.env.local` instead.

################################################################################
# Experiment config (YAML)
################################################################################

# Path to experiment YAML (recommended for multinode training)
OPENPI_CONFIG_YAML="configs/experiments/pi05_hsr_task6.yaml"

# Experiment name (used for checkpoint dir and W&B run name)
EXP_NAME="pi05_hsr_task6_run1"

################################################################################
# Training control
################################################################################

OPENPI_RESUME="0"      # 1 => pass --resume (continue from latest checkpoint)
OPENPI_OVERWRITE="1"   # 1 => pass --overwrite (start fresh)
# NOTE: OPENPI_RESUME and OPENPI_OVERWRITE cannot both be 1.

################################################################################
# Slurm settings (RUN-UV-SBATCH-OPENPI-MULTINODE.sh)
################################################################################

OPENPI_NUM_NODES="4"
OPENPI_GRES="gpu:8"
OPENPI_CPUS_PER_TASK="240"
OPENPI_SBATCH_ARGS="--partition=2-def --mem=1490000M --time=336:00:00"

################################################################################
# PBS settings (RUN-UV-QSUB-OPENPI-MULTINODE-SIMPLE.sh)
#   Edit the #PBS directives in the script directly for queue/project/select.
################################################################################

################################################################################
# Preflight checks (optional, Slurm only)
################################################################################

OPENPI_PREFLIGHT_ENABLE="1"
OPENPI_PREFLIGHT_SAMPLES_PER_NODE="20"
OPENPI_PREFLIGHT_RETRIES="3"
OPENPI_PREFLIGHT_BACKOFF_SEC="0.5"

################################################################################
# Aggregate stats (optional)
################################################################################

# Enable pre-training norm stats computation (Slurm launcher)
OPENPI_AGGREGATE_STATS_ENABLE="0"
# PBS launcher always computes stats if episodes_stats.jsonl exists.

################################################################################
# Legacy (non-YAML mode)
################################################################################

# Use these only if NOT using OPENPI_CONFIG_YAML:
# CONFIG_NAME="pi0_hsr_test"
# DATASET_NAME="task6"
