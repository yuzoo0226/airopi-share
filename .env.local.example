# Personal / machine-specific settings.
# Copy to `.env.local` and edit.
# Values here override `.env`.

################################################################################
# Credentials
################################################################################

WANDB_API_KEY="your_wandb_api_key"

################################################################################
# Paths (adjust to your machine / cluster)
################################################################################

# Working directory (defaults to script location)
# WORKING_DIR="/home/${USER}/AiroPi"

# Cache for uv, HuggingFace, tmp files, etc.
CACHE_ROOT="/home/${USER}/AiroPi/tmp_storage"

# Checkpoint output directory
CHECKPOINT_DIR="/home/${USER}/AiroPi/checkpoints"

# HuggingFace LeRobot home (for dataset metadata)
HF_LEROBOT_HOME="/home/datasets"

# Dataset root (usually inferred from YAML — only set to override)
# DATA_DIR="/home/datasets/lerobot_datasets"
